# SCEPTER-TE additions, read after minteq.v4.dat by both PHREEQC and te/chem.
# Gaines-Thomas exchange constants: Appelo & Postma (2005) Table 6.4, as in
# phreeqc.dat / wateq4f.dat (Ni from A&P). -gamma for majors as phreeqc.dat.
EXCHANGE_MASTER_SPECIES
X X-
EXCHANGE_SPECIES
X- = X-
	log_k 0
Na+ + X- = NaX
	log_k 0
	-gamma 4.08 0.082
K+ + X- = KX
	log_k 0.7
	-gamma 3.5 0.015
H+ + X- = HX
	log_k 1.0
	-gamma 9.0 0
NH4+ + X- = NH4X
	log_k 0.6
	-gamma 2.5 0
Ca+2 + 2 X- = CaX2
	log_k 0.8
	-gamma 5.0 0.165
Mg+2 + 2 X- = MgX2
	log_k 0.6
	-gamma 5.5 0.2
Al+3 + 3 X- = AlX3
	log_k 0.41
	-gamma 9.0 0
AlOH+2 + 2 X- = AlOHX2
	log_k 0.89
	-gamma 0 0
Ni+2 + 2 X- = NiX2
	log_k 0.62
Cu+2 + 2 X- = CuX2
	log_k 0.6
Zn+2 + 2 X- = ZnX2
	log_k 0.8
Cd+2 + 2 X- = CdX2
	log_k 0.8
Pb+2 + 2 X- = PbX2
	log_k 1.05
SURFACE_SPECIES
# Anions competing with arsenate on Hfo, not in minteq.v4.
# Carbonate: Van Geen et al. (1994) re-optimised for D&M (phreeqc.dat).
Hfo_wOH + CO3-2 + H+ = Hfo_wCO3- + H2O
	log_k 12.56
Hfo_wOH + CO3-2 + 2 H+ = Hfo_wHCO3 + H2O
	log_k 20.62
# Silicate: Swedlund & Webster (1999) (wateq4f.dat).
Hfo_wOH + H4SiO4 = Hfo_wH3SiO4 + H2O
	log_k 4.28
Hfo_wOH + H4SiO4 = Hfo_wH2SiO4- + H+ + H2O
	log_k -3.22
Hfo_wOH + H4SiO4 = Hfo_wHSiO4-2 + 2 H+ + H2O
	log_k -11.69
PHASES
Fix_H+
	H+ = H+
	log_k 0
Fix_pe
	e- = e-
	log_k 0
