# v25b production options (final GMD model, 2 Nov 2026). Source from the repository root. Replaces v22_options.env.
# Executable scepter_paddy_v25 = scepter.f90 at commit a8159b4, built with makefile_paddy_fast (slurm/build.sh).
# Calibration paddy/krxn_calibrated_v25b.in (commit b0ba34a): g2ch4 vmax 2280, ferrihydrite ageing fhage 0.1/yr,
# goethite reduction g2gt 60; calibrated on a fresh spin-up + 7-yr settle with this same file, so the global settle
# and chains both use it. Same as paddy/v25/stanage/chain_v25.sbatch (GMD v25b runs).
export TILL=0.2 XRS=,fhage KEEPALK=${KEEPALK:-}
export EXE=scepter_paddy_v25
export KRXN=${KRXN:-paddy/krxn_calibrated_v25b.in}
# Si root feedback strength w (baseline 0.15, joint Gong + slag fit, v25b); override W for sensitivity runs
export W=${W:-0.15}
# floodwater lateral discharge (--kaq) by water regime: irrigated 0.74, rainfed (--awd) 0.96; run_arch_v22.sh adds it
export KAQ_IRR=0.74 KAQ_RF=0.96
# soil options for the 3-yr drained spin-up (run_flooded_column.py ... --fallow)
export SOIL="--ch4 --n --kaol=0.05 --refsoil --gt=0.02 --exe=$EXE --kscale=maf:0.45,fsp:0.25,amsi:30 --n2c=0.03 --n2oy=6.2:1:0.1 --o2inh=2.5e-7 --nstep=13 --q=0.5 --fe3in=0.3 --fe3=0.012 --om=450 --omalloc=0.2:0.6:0.1"
# season/fallow options for run_chain.sh (later options override earlier ones, so archetype args win)
export PROD="--k=$KRXN --phd=14 --pox=0.3:0.9:6:1 --nucl=cc:0.001 --exe=$EXE --kscale=maf:0.45,fsp:0.25,amsi:30 --n2c=0.03 --n2oy=6.2:1:0.1 --o2inh=2.5e-7 --nstep=13 --q=0.5 --fe3in=0.3 --fe3=0.012 --om=450 --omalloc=0.2:0.6:0.1 --rtsi=2e-3:2.7e-4:$W"
# 0.5 m column with plough pan (25 cells), basal O2 0.21
export P21="--nz=25 --ztot=0.5 --pan=0.2:0.24:0.1:0.8:1:0.1:0.21:-1:0.3"
